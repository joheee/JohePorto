# Copy to .env.local and fill in. Firebase console > Project settings > General > Your apps (Web).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server only. Firebase console > Project settings > Service accounts > Generate new private key.
# Paste the entire JSON on ONE line (single-quoted).
FIREBASE_SERVICE_ACCOUNT_KEY=

# Firebase Auth UID of the owner (admin). Used by the server to authorize admin actions.
ADMIN_UID=

# Public address of the site (canonical links, sitemap, social previews). Optional on Vercel, where
# it falls back to the production domain. Set it when you add a custom domain, e.g. https://example.com
NEXT_PUBLIC_SITE_URL=

# Analytics (all optional). Visits are only counted in production by default: the development server shares its
# Firestore with production, so counting there would mix test visits into the real numbers.
# ANALYTICS_ENABLED=1        # count in development too (to try the Analytics page locally)
# ANALYTICS_ENABLED=0        # switch counting off everywhere
# ANALYTICS_SALT=            # a long random secret mixed into the one-day visitor hash (recommended)
# ANALYTICS_TIMEZONE=Asia/Jakarta   # the time zone days are counted in (default UTC)

# PageSpeed test on the Analytics page. Needed in practice: without a key Google shares one tiny quota between
# everyone and answers "quota used up" (seen on 2026-10-06). A free key: Google Cloud console > enable the
# "PageSpeed Insights API" > Credentials > Create API key. Add it for Production in Vercel and redeploy.
# PAGESPEED_API_KEY=
